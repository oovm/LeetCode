{
    "name": "@leetcode/conformance",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "LeetCode 完备性测试与 Valkyrie 对比基准（本地 sibling valkyrie.rs）",
    "exports": {
        ".": "./src/index.ts",
        "./catalog": "./src/catalog/generated.ts",
        "./registry": "./src/adapters/registry.ts",
        "./cli": "./src/cli/run.ts"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "node --import tsx src/cli/run.ts",
        "bench:python": "node --import tsx src/cli/run.ts --lang python",
        "bench:typescript": "node --import tsx src/cli/run.ts --lang typescript",
        "bench:typescript-bun": "node --import tsx src/cli/run.ts --lang typescript-bun",
        "bench:valkyrie": "node --import tsx src/cli/run.ts --lang valkyrie",
        "bench:wolfram-sxo": "node --import tsx src/cli/run.ts --lang wolfram-sxo",
        "bench:matlab-sxo": "node --import tsx src/cli/run.ts --lang matlab-sxo",
        "rebuild:bun": "pnpm rebuild bun"
    },
    "optionalDependencies": {
        "@sxo/core": "^0.0.8",
        "@sxo/mathematica": "^0.0.8",
        "@sxo/matlab": "^0.0.8"
    },
    "devDependencies": {
        "bun": "^1.2.0",
        "@valkyrie-language/vcc": "link:../../../valkyrie.rs/projects/packages/vcc",
        "@types/node": "^22.10.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^4.1.11"
    }
}
