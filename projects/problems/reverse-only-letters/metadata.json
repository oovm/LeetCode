{
    "id": "reverse-only-letters",
    "questionId": 917,
    "difficulty": "Easy",
    "tags": [
        "Two Pointers",
        "String"
    ],
    "tests": [
        {
            "args": {
                "s": "s-123-p"
            },
            "expected": "p-123-s"
        },
        {
            "args": {
                "s": "Test1ng-Leet=code-Q!"
            },
            "expected": "Qedo1ct-eeLg=ntse-T!"
        },
        {
            "args": {
                "s": "-a-b-"
            },
            "expected": "-b-a-"
        },
        {
            "args": {
                "s": "a-bC-dEf-ghIj"
            },
            "expected": "j-Ih-gfE-dCba"
        },
        {
            "args": {
                "s": "A-b-C-d-E"
            },
            "expected": "E-d-C-b-A"
        },
        {
            "args": {
                "s": "12345"
            },
            "expected": "12345"
        },
        {
            "args": {
                "s": "!@#$%^&*()"
            },
            "expected": "!@#$%^&*()"
        },
        {
            "args": {
                "s": "ab-cd"
            },
            "expected": "dc-ba"
        },
        {
            "args": {
                "s": "abcdefg"
