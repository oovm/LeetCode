{
    "id": "valid-palindrome",
    "questionId": 125,
    "difficulty": "Easy",
    "tags": ["Two Pointers", "String"],
    "tests": [
        {
            "args": {
                "s": "race a car"
            },
            "expected": false
        },
        {
            "args": {
                "s": " "
            },
            "expected": true
        },
        {
            "args": {
                "s": "Able was I ere I saw Elba"
            },
            "expected": true
        },
        {
            "args": {
                "s": "__Level__, __level__"
            },
            "expected": true
        },
        {
            "args": {
                "s": "No lemon, no melon"
            },
            "expected": true
        },
        {
            "args": {
                "s": "0P"
            },
            "expected": false
        },
        {
            "args": {
                "s": "_a!a_"
            },
            "expected": true
        },
        {
            "args": {
                "s": "Never odd or even"
            },
            "expected": true
        },
        {
            "args": {
                "s": "12345678987654321"
            },
            "expected": true
        },
        {
            "args": {
                "s": "Was it a car or a cat I saw?"
            },
            "expected": true
        },
        {
            "args": {
                "s": "No 'x' in Nixon"
            },
            "expected": true
        },
        {
            "args": {
                "s": "Able was I, I saw Elba"
            },
            "expected": true
        },
        {
            "args": {
                "s": "12321"
            },
            "expected": true
        },
        {
            "args": {
                "s": "Not a palindrome"
            },
            "expected": false
        },
        {
            "args": {
                "s": "Able was I, ere I saw Elba"
            },
            "expected": true
        },
        {
            "args": {
                "s": "123abcba321"
            },
            "expected": true
        },
        {
            "args": {
                "s": "Step on no pets"
            },
            "expected": true
        },
        {
            "args": {
                "s": "A man, a plan, a canal: Panama"
            },
            "expected": true
        },
        {
            "args": {
                "s": "Madam, in Eden, I'm Adam"
            },
            "expected": true
        },
        {
            "args": {
                "s": "123abccba321"
            },
            "expected": true
        },
        {
            "args": {
                "s": "__^_^__"
            },
            "expected": true
        }
