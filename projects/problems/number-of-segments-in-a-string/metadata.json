{
    "id": "number-of-segments-in-a-string",
    "questionId": 434,
    "difficulty": "Easy",
    "tags": ["String"],
    "tests": [
        {
            "args": {
                "s": "Hello, my name is John"
            },
            "expected": 5
        },
        {
            "args": {
                "s": "Hello"
            },
            "expected": 1
        },
        {
            "args": {
                "s": "Punctuation,should,not:be;problematic"
            },
            "expected": 1
        },
        {
            "args": {
                "s": "New\nlines\nare\nalso\nsegments"
            },
            "expected": 5
        },
        {
            "args": {
                "s": "Mixed    \t  \n  delimiters    should    work"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "NoSpaces"
            },
            "expected": 1
        },
        {
            "args": {
                "s": "OneTwoThreeFour"
            },
            "expected": 1
        },
        {
            "args": {
                "s": "\t   \t   Hello   \t   my   \t   name   \t   is   \t   John   \t"
            },
            "expected": 5
        },
        {
            "args": {
                "s": ""
            },
            "expected": 0
        },
        {
            "args": {
                "s": "Multiple    spaces between words"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "   Hello,   my name is John   "
            },
            "expected": 5
        },
        {
            "args": {
                "s": "Leading and trailing spaces should be ignored   "
            },
            "expected": 7
        },
        {
            "args": {
                "s": "Punctuation, should! not? matter: here."
            },
            "expected": 5
        },
        {
            "args": {
                "s": "123 456 789 0"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "Mixing\t\nand\tspecial\t\ncharacters"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "Multiple   spaces   between words"
            },
            "expected": 4
        },
        {
            "args": {
                "s": " Leading and trailing spaces "
            },
            "expected": 4
        },
        {
            "args": {
                "s": "\tTabs\tare\tconsidered\tspaces"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "\t\t\tTabbed\t\t\tSegments\t\t\t"
            },
            "expected": 2
        },
        {
            "args": {
                "s": "  a  b  c  d  e  "
            },
            "expected": 5
        },
        {
            "args": {
                "s": "   Unicode spaces   "
            },
            "expected": 2
        },
        {
            "args": {
                "s": "    a   b   c   "
            },
            "expected": 3
        },
        {
            "args": {
                "s": "   "
            },
            "expected": 0
        },
        {
            "args": {
                "s": "Hello\tmy\tname\tis\tJohn"
            },
            "expected": 5
        },
        {
            "args": {
                "s": "    "
            },
            "expected": 0
        },
        {
            "args": {
                "s": "\nNew\nlines\nare\nspaces\ntoo"
            },
            "expected": 5
        },
        {
            "args": {
                "s": "Punctuation, should! not? affect: the; count"
            },
            "expected": 6
        },
        {
            "args": {
                "s": "Multiple     spaces   between   words"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "   Hello, my name is John   "
            },
            "expected": 5
        },
        {
            "args": {
                "s": "a b c d e f g"
            },
            "expected": 7
        },
        {
            "args": {
                "s": "Hello    my     name    is    John"
            },
            "expected": 5
        },
        {
            "args": {
                "s": "\tTabs\tare\tcounted\tas\tspaces"
            },
            "expected": 5
        },
        {
            "args": {
                "s": "Mixed\tTabs\t\tand\t\t\tSpaces"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "   Leading and trailing spaces   "
            },
            "expected": 4
        },
        {
            "args": {
                "s": "Multiple    spaces    between   words"
            },
            "expected": 4
        },
        {
            "args": {
                "s": "SingleWord"
            },
            "expected": 1
        },
        {
            "args": {
                "s": "Tab\tSeparated"
            },
            "expected": 2
        },
        {
            "args": {
                "s": "\nHello\nmy\nname\nis\nJohn\n"
            },
            "expected": 5
        }
    ],
    "invoke": {
        "python": "Solution().countSegments",
        "typescript": "Solution().countSegments",
        "valkyrie": "countSegments"
    }
}
